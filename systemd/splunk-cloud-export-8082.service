[Unit]
Description=Splunk Cloud Export Console (TCP 8082)
After=network-online.target
Wants=network-online.target

[Service]
User=splunkexport
Group=splunkexport
WorkingDirectory=/opt/splunk-cloud-export/app
EnvironmentFile=/etc/splunk-cloud-export/app.env
ExecStart=/opt/splunk-cloud-export/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8082
# Export workers run in their own process session.  Do not terminate them when
# the web console is restarted for a code or configuration deployment.
KillMode=process
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
